# Copia este archivo a .env y rellena los valores. .env no se sube a git.

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo (el "cerebro") que usa el agente. Lista en https://openrouter.ai/models
# Barato: google/gemini-2.5-flash. Otros: anthropic/claude-sonnet-5.5, google/gemini-2.5-flash-lite
MODELO=google/gemini-2.5-flash

# Supabase del CRM: Project Settings -> API (los mismos que crm/.env.local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Carpeta de las facturas de proveedores (dentro de agente/)
CARPETA=facturas
